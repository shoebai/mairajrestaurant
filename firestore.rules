rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the menu, offers, gallery, about content and site
    // settings — needed so the public website can display them.
    // Only a signed-in admin (logged into /admin) can create, edit, or delete.
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Homepage photos and other site settings.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
