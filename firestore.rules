rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these accounts can change the website from /admin.
    // To add another admin, add their email to the list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['yshoeb52@gmail.com'];
    }

    // Anyone can read — the public website needs this.
    // Only an admin can create, edit, or delete.
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage photos, text, watermark and other site settings.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Which device each admin is signed in on (one device at a time).
    // Each admin can only see and change their own record.
    match /adminSessions/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }
  }
}
